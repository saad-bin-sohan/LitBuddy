NODE_ENV=production
PORT=5001

MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority

JWT_SECRET=your_random_secret
FRONTEND_URL=https://litbuddy.vercel.app
FRONTEND_URLS=https://litbuddy.vercel.app,https://litbuddy-git-main-sohans-projects-2369087a.vercel.app/,https://litbuddy-irm549e7i-sohans-projects-2369087a.vercel.app/

# Auth cookie settings
AUTH_COOKIE_NAME=token
AUTH_COOKIE_SAME_SITE=Lax
AUTH_COOKIE_SECURE=true
# AUTH_COOKIE_DOMAIN=.example.com
AUTH_ALLOW_BEARER_FALLBACK=true

# Cloudinary — profile photo storage
# Sign up at https://cloudinary.com (free tier: 25 GB storage, 25 GB bandwidth/month)
# Find these in your Cloudinary dashboard under Settings > API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
