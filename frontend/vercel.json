{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://litbuddy.onrender.com/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://litbuddy.onrender.com/uploads/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "build": {
    "env": {
      "VITE_API_BASE_URL": "/api",
      "VITE_WS_BASE_URL": "wss://litbuddy.onrender.com/ws",
      "VITE_GOOGLE_CLIENT_ID": "751790859074-vuu7gn21egi6r723kb27vt3ppdiihfs5.apps.googleusercontent.com"
    }
  }
}
